# Doggystyle – Production environment variables
# Copy this file to .env.production (never commit that file).
# Set all secrets via your hosting provider's secret management
# (e.g. `fly secrets set KEY=value`).
#
# ─── Required ─────────────────────────────────────────────────────────────────

# Full PostgreSQL connection URL (provided by Fly Postgres or external DB)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Random 32+ character strings — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=<generate-a-strong-random-secret>
TOKEN_PEPPER=<generate-a-strong-random-secret>

# Admin account created on first SEED_ON_START run
ADMIN_EMAIL=admin@yourdomainhere.com
ADMIN_PASSWORD=<strong-unique-password>

# ─── Runtime behaviour ────────────────────────────────────────────────────────
NODE_ENV=production
ROLE=both
API_PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
LOG_PRETTY=false

# Must match the public HTTPS URL (no trailing slash)
PUBLIC_URL=https://doggystyle-beta.fly.dev

SERVE_WEB=true
COOKIE_SECURE=true
DEMO_MODE=false

# ─── Media storage ────────────────────────────────────────────────────────────
# Fly volume is mounted at /app/storage/media (see fly.toml [mounts])
MEDIA_DIR=/app/storage/media
MAX_UPLOAD_MB=12

# ─── Optional: AI (leave blank to use the built-in heuristic engine) ──────────
AI_PROVIDER=heuristic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ─── Optional: email delivery (leave blank to store mail in the DB) ───────────
MAIL_TRANSPORT=store
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Doggystyle <hello@example.com>

# ─── Optional: social login (disable if credentials are not configured) ───────
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
