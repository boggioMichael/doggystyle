{
  "name": "@doggystyle/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/seed/run.ts",
    "db:reset": "tsx src/db/reset.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@doggystyle/shared": "*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.2.0",
    "drizzle-orm": "^0.44.6",
    "fastify": "^5.6.1",
    "nodemailer": "^7.0.9",
    "pino": "^9.13.1",
    "postgres": "^3.4.7",
    "sharp": "^0.34.4",
    "yauzl": "^3.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.9",
    "@types/nodemailer": "^7.0.4",
    "@types/yauzl": "^2.10.3",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.5",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
