# ─────────────────────────────────────────────────────────────────────────────
# Doggystyle — environment configuration
# Copy to `.env`. `./start.sh` / `.\start.ps1` creates it and fills the secrets
# for you on first run. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Branding ────────────────────────────────────────────────────────────────
BRAND_NAME=Doggystyle
BRAND_TAGLINE=Tell us what you want for your dog. We do the rest.

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
# Public origin the browser uses. Caddy serves web + API on this single origin.
PUBLIC_URL=http://localhost:8080
API_PORT=4000
WEB_PORT=5173
PROXY_PORT=8080

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=doggystyle
POSTGRES_PASSWORD=change-me-generated-on-first-run
POSTGRES_DB=doggystyle
POSTGRES_PORT=5433
# Inside Docker the host is `db`; for `npm run dev` on the host it is localhost.
DATABASE_URL=postgres://doggystyle:change-me-generated-on-first-run@localhost:5433/doggystyle

# ── Secrets (generated on first run — 32+ random bytes, hex) ────────────────
SESSION_SECRET=change-me-generated-on-first-run
TOKEN_PEPPER=change-me-generated-on-first-run

# ── Sessions ────────────────────────────────────────────────────────────────
SESSION_TTL_HOURS=720
MAGIC_LINK_TTL_MINUTES=15
COOKIE_SECURE=false

# ── Media ───────────────────────────────────────────────────────────────────
MEDIA_DIR=./storage/media
MAX_UPLOAD_MB=12
MAX_FILES_PER_REQUEST=30

# ── AI ──────────────────────────────────────────────────────────────────────
# heuristic = fully offline, zero cost, no key needed (default)
# anthropic = higher-quality phrasing/extraction; requires ANTHROPIC_API_KEY
AI_PROVIDER=heuristic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_TIMEOUT_MS=20000

# ── Mail (Mailpit in local dev — open http://localhost:8025 to read mail) ────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Doggystyle <hello@doggystyle.local>"

# ── Demo mode ───────────────────────────────────────────────────────────────
# Enables the `demo` social provider, seeded dogs, and the "simulate other
# owner" controls. Turn OFF for anything resembling production.
DEMO_MODE=true
SEED_ON_START=true

# ── Social providers (all optional — the product works without any of them) ──
# See docs/INTEGRATIONS.md for the exact steps to obtain these.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true

# ── Admin bootstrap (demo only) ─────────────────────────────────────────────
ADMIN_EMAIL=admin@doggystyle.local
ADMIN_PASSWORD=DemoAdmin!2026
